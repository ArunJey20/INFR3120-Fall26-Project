<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Shift History</title>

    <!-- Links the CSS stylesheet -->
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>

    <!-- Displays the navigation bar and website logo -->
    <div class="Nav-Bar">
        <header>
            <img src="/images/logo.png" alt="ShiftTrack Logo" class="logo">
            <h2>ShiftTrack</h2>
        </header>

        <nav>
            <a href="/">Home</a>
            <!-- Link to homepage -->

            <a href="/shifts">Shift History</a>
            <!-- Link to view previous shifts -->

            <a href="/add-shift">Add Shift</a>
            <!-- Link to add shift page -->
        </nav>

        <div class="clear"></div>
    </div>

    <!-- Main section for shift history -->
    <div class="shift-history">

        <!-- Displays the page heading -->
        <h1>Shift History</h1>

        <!-- Displays the shift information headings -->
        <div class="shift-details">
            <h3>Shift Date</h3>
            <p>No shifts recorded yet.</p>
        </div>

        <div class="shift-details">
            <h3>Start Time</h3>
            <p>No information available.</p>
        </div>

        <div class="shift-details">
            <h3>End Time</h3>
            <p>No information available.</p>
        </div>

        <div class="shift-details">
            <h3>Hours Worked</h3>
            <p>No information available.</p>
        </div>

        <div class="shift-details">
            <h3>Hourly Wage</h3>
            <p>No information available.</p>
        </div>

        <div class="shift-details">
            <h3>Estimated Earnings</h3>
            <p>No information available.</p>
        </div>

    </div>
</body>

<!-- Displays the website footer -->
<footer>
    <p>&copy;2026 ShiftTrack. All rights reserved.</p>
    <!-- Copyright information -->
</footer>

</html>